{
  "name": "korean-speaking-api",
  "version": "1.0.0",
  "description": "Backend API for Korean Speaking Assessment and Learning Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "rimraf dist && tsc",
